# Discord 測試配置檔案
# 將此檔案複製為 .env 並填入實際值

# Discord Bot 配置
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_SERVER_ID=your_server_id_here
DISCORD_TEST_CHANNEL_ID=your_test_channel_id_here

# Worker 配置
WORKER_URL=https://your-worker.workers.dev

# AI API 配置
AI_API_URL=https://your-ai-api.com
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-3.5-turbo

# 測試用戶配置
TEST_USER_ID=your_discord_user_id_here
TEST_CHARACTER_ID=char-001

# 其他設定
LOG_LEVEL=debug
