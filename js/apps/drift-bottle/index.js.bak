import Router from '../../router.js';
import { createElement } from '../../components.js';
import { CharactersDB, SettingsDB } from '../../db.js';
import APIClient from '../../api.js';

let lastCard = null;

async function loadLastCard() {
  const saved = await SettingsDB.get('drift_last_card');
  if (saved) {
    lastCard = saved;
  }
}

async function saveLastCard() {
  await SettingsDB.set('drift_last_card', lastCard);
}

async function generateDivinationReading(cardName, isUpright, character) {
  const settings = await APIClient.getSettings();
  
  if (!settings.api_url || !settings.api_key) {
    return {
      meaning: isUpright ? '?½é??†æš¢ï¼Œå»ºè­°é??¢è€Œç‚º' : '?½é??—é˜»ï¼Œå»ºè­°å??å…§?¨é?ç¤?,
      advice: isUpright 
        ? 'æ­¤ç?æ­??ï¼Œèƒ½?é??¢ï?å»ºè­°?†å‹¢?Œç‚º??
        : 'æ­¤ç??†ä?ï¼Œèƒ½?å??»ï?å»ºè­°?æ€å…§?¨é?ç¤™ã€?
    };
  }
  
  const position = isUpright ? 'æ­??' : '?†ä?';
  const characterPersonality = character?.personality || 'ä¸€ä½ç?ç§˜ç?è§’è‰²';
  const characterName = character?.name || 'ç¥žç?äººç‰©';
  
  const systemPrompt = `ä½ æ˜¯ä¸€ä½å?æ¥­ç?å¡”ç??Œå??œå¸«?‚è??¹æ??½åˆ°?„ç??ç?ä½ï?ä»¥å?è§’è‰²?„æ€§æ ¼?¹è³ªï¼Œæ?ä¾›å€‹äºº?–ç?? å?è§????
è«‹ç”¨æº«å??ç?ç§˜ä?å¯Œæ??Ÿç™¼?§ç?èªžæ°£?žæ???
?žè??¼å?å¿…é??¯JSONï¼?
{"meaning": "?Œç¾©è§??ï¼ˆä??¥è©±ï¼?, "advice": "?·é?å»ºè­°ï¼?-2?¥è©±ï¼?}`;
  
  const userPrompt = `?½åˆ°äº†ã€?{cardName}?ç?ï¼?{position}??
è§’è‰²?ç¨±ï¼?{characterName}
è§’è‰²?§æ ¼ï¼?{characterPersonality}
è«‹ç‚ºæ­¤è??²æ?ä¾›å€‹äºº?–ç?? å?è§???‚`;
  
  try {
    const response = await fetch(`${settings.api_url}/v1/chat/completions`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${settings.api_key}`
      },
      body: JSON.stringify({
        model: settings.model || 'gpt-3.5-turbo',
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: userPrompt }
        ],
        temperature: 0.8,
        max_tokens: 200
      })
    });
    
    if (!response.ok) {
      throw new Error('APIè«‹æ?å¤±æ?');
    }
    
    const data = await response.json();
    const content = data.choices?.[0]?.message?.content;
    
    if (content) {
      const parsed = JSON.parse(content);
      return {
        meaning: parsed.meaning || (isUpright ? '?½é??†æš¢' : '?½é??—é˜»'),
        advice: parsed.advice || (isUpright ? '?†å‹¢?Œç‚º?? : '?æ€å…§?¨é?ç¤™ã€?)
      };
    }
  } catch (error) {
    console.error('?Ÿæ?? å?è§??å¤±æ?:', error);
  }
  
  return {
    meaning: isUpright ? '?½é??†æš¢ï¼Œå»ºè­°é??¢è€Œç‚º' : '?½é??—é˜»ï¼Œå»ºè­°å??å…§?¨é?ç¤?,
    advice: isUpright 
